rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null || true;
    }
    match /transactions/{txId} {
      allow read, write: if request.auth != null || true;
    }
    match /logs/{logId} {
      allow read, write: if request.auth != null || true;
    }
    match /settings/{settingId} {
      allow read, write: if request.auth != null || true;
    }
  }
}
